# Required for all deployments. Use distinct credentials for each service.
# Use at least 32 printable, non-space ASCII characters for QUELLE_TOKEN.
QUELLE_TOKEN=

# Search engines: brave, duckduckgo, bing, mwmbl, mojeek, wikipedia, stackexchange, hackernews, arxiv, github, searxng.
# Default: brave when BRAVE_SEARCH_API_KEY is set, otherwise keyless meta-search
# (duckduckgo,mwmbl,wikipedia,stackexchange,hackernews) fused in parallel via RRF.
# Set none for direct URL reads only.
# QUELLE_SEARCH_ENGINES=duckduckgo,mwmbl,wikipedia,stackexchange,hackernews
# Discovery mode when multiple engines are configured: fuse (default, parallel RRF) or rotate (sequential fallback).
# QUELLE_SEARCH_MODE=fuse
# Optional self-hosted SearXNG backend when "searxng" is included in QUELLE_SEARCH_ENGINES:
# QUELLE_SEARXNG_URL=http://127.0.0.1:8080
# QUELLE_SEARXNG_ENGINES=
# QUELLE_SEARXNG_CATEGORIES=general
# Required when brave or mojeek is selected, respectively:
# BRAVE_SEARCH_API_KEY=
# MOJEEK_API_KEY=
# Optional for identified Mwmbl access:
# MWMBL_API_KEY=

# Enable /api/answer by uncommenting and filling in all three.
# Leave these commented for /api/content alone.
# QUELLE_MODEL_BASE_URL=https://model.example.org/v1
# QUELLE_MODEL_API_KEY=
# QUELLE_MODEL_NAME=

# Optional answer setting
# QUELLE_MODEL_CONTEXT_TOKENS=64000

# Optional dedicated reranker; content mode opts in with "selection":"rerank".
# Answer mode uses it in place of chat ranking when configured.
# Full /rerank endpoint (operator-controlled HTTP or HTTPS); model is required.
# QUELLE_RERANK_URL=http://127.0.0.1:8004/rerank
# QUELLE_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
# QUELLE_RERANK_API_KEY=
# QUELLE_RERANK_TIMEOUT_MS=3000

# Optional service settings. Docker binds to 0.0.0.0:3000 by default.
# BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
# MOJEEK_SEARCH_URL=https://api.mojeek.com/search
# QUELLE_LISTEN=127.0.0.1:3000
# QUELLE_CONCURRENCY=8
# QUELLE_USER_AGENT=
# QUELLE_LIGHTPANDA=/usr/local/bin/lightpanda
# Extra networks page fetches must not reach, such as non-private cluster ranges:
# QUELLE_BLOCKED_NETWORKS=
# Optional HTTP/HTTPS/SOCKS proxy for outbound page fetches:
# QUELLE_PROXY_URL=
# Optional Chromium CDP fallback (e.g. http://127.0.0.1:9222) for screenshots and Chromium-only SPAs:
# QUELLE_CHROMIUM_CDP_URL=
# Optional external Playwright/Chromium sidecar (e.g. http://127.0.0.1:3003/scrape) as Tier 3 fallback:
# QUELLE_BROWSER_URL=
# PDF OCR fallback for scanned/image-only PDFs using LlamaIndex OCRia-nano-1 via LiteParse (`lit` CLI):
# Install once: `cargo install liteparse && lit models pull ocria-nano`
# QUELLE_OCR_MODE=auto        # auto (default: lit/OCRia-nano-1 -> QUELLE_OCR_URL), ocria, sidecar, off
# QUELLE_OCR_BACKEND=ocria-nano  # ocria-nano (default) or tesseract
# QUELLE_LITEPARSE_BIN=       # optional explicit path to `lit` binary (auto-detected on PATH)
# Optional HTTP OCR sidecar fallback (e.g. http://127.0.0.1:3004/ocr):
# QUELLE_OCR_URL=
# Per-host politeness limits (concurrent requests per host and minimum delay in ms):
# QUELLE_HOST_CONCURRENCY=2
# QUELLE_HOST_SPACING_MS=250
# Maximum concurrent browser renders (Lightpanda / sidecar), 1-16 (default 4):
# QUELLE_RENDER_CONCURRENCY=4
# Keep a persistent Lightpanda CDP server over a private Unix socket with non-content asset blocking (default true):
# QUELLE_CDP_POOL=true
# Default maximum PDF pages extracted per document, 1-1000 (default 150; overridable per request via maxPages):
# QUELLE_PDF_MAX_PAGES=150
# Optional writable directory to persist incremental crawl snapshots (sinceCrawlId) and mid-crawl resume checkpoints across restarts:
# QUELLE_STATE_DIR=
